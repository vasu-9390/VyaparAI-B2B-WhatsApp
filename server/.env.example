# ==============================================================================
# VyaparAI Backend Environment Configuration
# Copy this file to .env and populate with your local/cloud credentials.
# ==============================================================================

# Server Core
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb://localhost:27017/vyaparai_dev

# Authentication & Security
# Generate a strong 32+ character random string for production
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_vyapar_ai_2026
JWT_EXPIRES_IN=7d

# Google Gemini AI Integration
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# WhatsApp Business Cloud API (Meta Developers)
# https://developers.facebook.com/docs/whatsapp/cloud-api/
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_account_id
WHATSAPP_VERIFY_TOKEN=vyapar_ai_webhook_verify_token_secure_string
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_verification
WHATSAPP_API_VERSION=v21.0

# Multilingual Speech-to-Text Provider (mock | whisper | google)
SPEECH_TO_TEXT_PROVIDER=mock
SPEECH_TO_TEXT_API_KEY=optional_stt_api_key

# Background Job Queue (Optional - defaults to in-memory queue if empty)
REDIS_URL=redis://localhost:6379

# Storage Directory for Quotation PDFs
STORAGE_DIR=./storage
